{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SendeyizGPT",
  "version": "0.1.0",
  "identifier": "com.sendeyiz.gpt",
  "mainBinaryName": "sendeyizgpt",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../../frontend",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../../frontend"
    },
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SendeyizGPT",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; img-src 'self' asset: https://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../runtime/llama.cpp-vulkan/": "runtime/llama.cpp-vulkan/"
    },
    "targets": ["msi", "nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
